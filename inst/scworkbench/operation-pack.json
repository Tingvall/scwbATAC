{
  "schema_version": "scworkbench.operation_pack.v3",
  "pack_abi_version": "3",
  "identity_scheme": "scworkbench.operation_pack.canonical_json.v1",
  "namespace": "scwbatac",
  "package": {"name": "scwbATAC", "version": "0.1.2"},
  "backend": "R",
  "compatibility": {
    "scworkbench": {"minimum": "0.1.2", "maximum_exclusive": "0.2.0"},
    "pack_abi": {"minimum": "3", "maximum": "3"}
  },
  "entry_point": "scwbATAC::register_operation_pack",
  "operations": [{
    "name": "chromvar",
    "qualified_name": "scwbatac::chromvar",
    "title": "Genome-backed chromVAR motif deviations",
    "description": "Compute chromVAR deviations from one authenticated peak matrix, genomic-source snapshot, and bounded motif registry reads.",
    "runner": ".atac_chromvar",
    "inputs": [{"name": "matrix", "kind": "matrix", "required": true,
      "alignment": "cell_and_feature_ordered"}],
    "params_schema": {"type": "object", "additionalProperties": false,
      "properties": {
        "motif_library": {"type": "string", "minLength": 1},
        "motifs": {"type": ["array", "null"], "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}, "default": null},
        "motif_match_set": {"type": ["string", "null"], "minLength": 1,
          "default": null},
        "min_motif_peaks": {"type": "integer", "minimum": 1, "default": 10},
        "max_motif_peaks": {"type": ["integer", "null"], "minimum": 1},
        "motif_p_cutoff": {"type": "number", "exclusiveMinimum": 0,
          "exclusiveMaximum": 1, "default": 0.00005},
        "motif_w": {"type": "integer", "minimum": 1, "default": 7},
        "seqlevels_mode": {"type": "string", "enum": ["standard", "all"],
          "default": "standard"},
        "seqlevels_include": {"type": ["array", "null"],
          "uniqueItems": true, "items": {"type": "string", "minLength": 1},
          "default": null},
        "seqlevels_exclude": {"type": ["array", "null"],
          "uniqueItems": true, "items": {"type": "string", "minLength": 1},
          "default": null},
        "background_iterations": {"type": "integer", "minimum": 1,
          "default": 50},
        "background_w": {"type": "number", "exclusiveMinimum": 0,
          "default": 0.1},
        "background_bs": {"type": "integer", "minimum": 2,
          "default": 50},
        "chunk_size": {"type": "integer", "minimum": 1, "maximum": 4096,
          "default": 256}
      }, "required": ["motif_library"]},
    "registry_reads": [
      {"name": "genomic_source", "category": "authenticated_core_registry_snapshot",
        "kind": "genomic_matrix_source", "reader": "read_genomic_matrix_source",
        "matrix_input": "matrix", "row_order": "matrix_feature_order_v1",
        "call_discipline": "single_use"},
      {"name": "motif_library", "category": "authenticated_core_registry_snapshot",
        "kind": "motif_library", "reader": "read_motif_library",
        "library_parameter": "motif_library", "call_discipline": "single_use"},
      {"name": "motif_match_set", "category": "authenticated_core_registry_snapshot",
        "kind": "motif_match_set", "reader": "read_motif_match_set",
        "match_set_parameter": "motif_match_set", "call_discipline": "single_use"}
    ],
    "typed_slice_reads": [{
      "name": "chunks", "input": "matrix", "reader": "read_typed_slices",
      "kind": "matrix", "supported_axes": ["cells"],
      "chunk_axis": "cells", "chunk_size_parameter": "chunk_size",
      "call_discipline": "ordered_partition_exactly_once",
      "empty_selection_policy": "reject", "duplicate_policy": "reject",
      "value_policy": "nonnegative_integer_v1",
      "selection": {
        "cells": {"policy": "effective_input_axis_v1"},
        "features": {"policy": "effective_input_axis_v1"}
      }
    }],
    "dimension_policies": [
      {"output": "deviation_z", "policy": "runtime_ordered_cell_family_v1",
        "group": "motif_keys", "source_read": "genomic_source",
        "row_order": "cell_major_then_declared_key_v1",
        "missing_values": "allowed",
        "maximum_keys": 10000, "maximum_rows": 12000000},
      {"output": "deviation_raw", "policy": "runtime_ordered_cell_family_v1",
        "group": "motif_keys", "source_read": "genomic_source",
        "row_order": "cell_major_then_declared_key_v1",
        "missing_values": "allowed",
        "maximum_keys": 10000, "maximum_rows": 12000000},
      {"output": "motif_summary", "policy": "data_dependent_table_v1"}
    ],
    "outputs": [
      {"name": "deviation_z", "category": "terminal_artifact",
        "kind": "cell_vector_family", "storage_profile": "terminal_primitive_v1",
        "allocated_id_key": "deviation_z_id", "required": true,
        "promotion_group": "analysis", "value_kind": "continuous"},
      {"name": "deviation_raw", "category": "terminal_artifact",
        "kind": "cell_vector_family", "storage_profile": "terminal_primitive_v1",
        "allocated_id_key": "deviation_raw_id", "required": true,
        "promotion_group": "analysis", "value_kind": "continuous"},
      {"name": "motif_summary", "category": "terminal_artifact",
        "kind": "obs_table", "storage_profile": "terminal_primitive_v1",
        "allocated_id_key": "motif_summary_id", "required": true,
        "promotion_group": "analysis", "table_type": "chromvar_summary"}
    ],
    "dependencies": [
      {"requirement_id": "chromvar", "kind": "r_package", "name": "chromVAR",
        "version": {"scheme": "r_package_version_constraint_v1",
          "specifier": ">=0.1.0,<999.0.0"},
        "disposition": "required", "import_probe": "chromVAR"},
      {"requirement_id": "motifmatchr", "kind": "r_package", "name": "motifmatchr",
        "version": {"scheme": "r_package_version_constraint_v1",
          "specifier": ">=0.1.0,<999.0.0"},
        "disposition": "required", "import_probe": "motifmatchr"},
      {"requirement_id": "tfbstools", "kind": "r_package", "name": "TFBSTools",
        "version": {"scheme": "r_package_version_constraint_v1",
          "specifier": ">=0.1.0,<999.0.0"},
        "disposition": "required", "import_probe": "TFBSTools"},
      {"requirement_id": "matrix", "kind": "r_package", "name": "Matrix",
        "version": {"scheme": "r_package_version_constraint_v1",
          "specifier": ">=0.1.0,<999.0.0"},
        "disposition": "required", "import_probe": "Matrix"},
      {"requirement_id": "summarized_experiment", "kind": "r_package",
        "name": "SummarizedExperiment",
        "version": {"scheme": "r_package_version_constraint_v1",
          "specifier": ">=0.1.0,<999.0.0"},
        "disposition": "required", "import_probe": "SummarizedExperiment"},
      {"requirement_id": "genomic_ranges", "kind": "r_package",
        "name": "GenomicRanges",
        "version": {"scheme": "r_package_version_constraint_v1",
          "specifier": ">=0.1.0,<999.0.0"},
        "disposition": "required", "import_probe": "GenomicRanges"},
      {"requirement_id": "genome_info_db", "kind": "r_package",
        "name": "GenomeInfoDb",
        "version": {"scheme": "r_package_version_constraint_v1",
          "specifier": ">=0.1.0,<999.0.0"},
        "disposition": "required", "import_probe": "GenomeInfoDb"},
      {"requirement_id": "s4vectors", "kind": "r_package", "name": "S4Vectors",
        "version": {"scheme": "r_package_version_constraint_v1",
          "specifier": ">=0.1.0,<999.0.0"},
        "disposition": "required", "import_probe": "S4Vectors"},
      {"requirement_id": "biocparallel", "kind": "r_package",
        "name": "BiocParallel",
        "version": {"scheme": "r_package_version_constraint_v1",
          "specifier": ">=0.1.0,<999.0.0"},
        "disposition": "required", "import_probe": "BiocParallel"},
      {"requirement_id": "provider", "kind": "dynamic_matrix_registry_package",
        "matrix_input": "matrix", "registry_read": "genomic_source",
        "metadata_field": "genome_provider", "ecosystem": "R",
        "package_name_scheme": "r_package_name_v1",
        "probe": "r_namespace_exports_v1", "disposition": "required",
        "version_policy": "record_resolved_installed_version_v1"}
    ],
    "promotion_closure": {
      "deviation_z": ["deviation_raw", "deviation_z", "motif_summary"],
      "deviation_raw": ["deviation_raw", "deviation_z", "motif_summary"],
      "motif_summary": ["deviation_raw", "deviation_z", "motif_summary"]
    },
    "replay_equivalence": {
      "deviation_z": "exact_canonical_value",
      "deviation_raw": "exact_canonical_value",
      "motif_summary": "exact_canonical_value"
    }
  }, {
    "name": "hvp_select",
    "qualified_name": "scwbatac::hvp_select",
    "title": "Highly variable peak selection",
    "description": "Select highly variable peaks by raw or log-depth-adjusted binary accessibility variance with detection-percentage filtering.",
    "runner": ".atac_hvp_select",
    "inputs": [{"name": "matrix", "kind": "matrix", "required": true,
      "alignment": "cell_and_feature_ordered"}],
    "params_schema": {"type": "object", "additionalProperties": false,
      "properties": {
        "n_features": {"type": "integer", "minimum": 1,
          "maximum": 1000000, "default": 25000},
        "depth_adjustment": {"type": "boolean", "default": true},
        "min_detection_pct": {"type": "number", "minimum": 0,
          "maximum": 100, "default": 0},
        "max_detection_pct": {"type": "number", "minimum": 0,
          "maximum": 100, "default": 100},
        "chunk_size": {"type": "integer", "minimum": 1,
          "maximum": 4096, "default": 256}
      }},
    "registry_reads": [{
      "name": "feature_annotations",
      "category": "authenticated_core_registry_snapshot",
      "kind": "matrix_feature_annotations",
      "reader": "read_matrix_feature_annotations",
      "matrix_input": "matrix",
      "fields": ["feature_type"],
      "row_order": "matrix_feature_order_v1",
      "missing_annotation_policy": "preserve_null",
      "call_discipline": "single_use"
    }],
    "typed_slice_reads": [{
      "name": "matrix_chunks", "input": "matrix",
      "reader": "read_typed_slices", "kind": "matrix",
      "supported_axes": ["cells"], "chunk_axis": "cells",
      "chunk_size_parameter": "chunk_size",
      "call_discipline": "ordered_partition_exactly_once",
      "empty_selection_policy": "reject", "duplicate_policy": "reject",
      "value_policy": "nonnegative_integer_v1",
      "selection": {
        "cells": {"policy": "effective_input_axis_v1"},
        "features": {"policy": "effective_input_axis_v1"}
      }
    }],
    "dimension_policies": [
      {"output": "selected_features", "policy": "data_dependent_table_v1"},
      {"output": "fit_summary", "policy": "data_dependent_table_v1"}
    ],
    "outputs": [
      {"name": "selected_features", "category": "terminal_artifact",
        "kind": "feature_table", "storage_profile": "terminal_primitive_v1",
        "allocated_id_key": "hvp_selected_features_id", "required": true,
        "promotion_group": "hvp", "table_type": "feature_selection_table"},
      {"name": "fit_summary", "category": "terminal_artifact",
        "kind": "obs_table", "storage_profile": "terminal_primitive_v1",
        "allocated_id_key": "hvp_fit_summary_id", "required": true,
        "promotion_group": "hvp", "table_type": "hvp_select_summary"}
    ],
    "dependencies": [
      {"requirement_id": "scworkbench_runtime", "kind": "r_package",
        "name": "scworkbench", "disposition": "required",
        "import_probe": "wb_prim_feature_table",
        "version": {"scheme": "r_package_version_constraint_v1",
          "specifier": ">=0.1.0,<1.0.0"}},
      {"requirement_id": "matrix_runtime", "kind": "r_package",
        "name": "Matrix", "disposition": "required",
        "import_probe": "rowSums",
        "version": {"scheme": "r_package_version_constraint_v1",
          "specifier": ">=1.3.0"}}
    ],
    "promotion_closure": {
      "selected_features": ["fit_summary", "selected_features"],
      "fit_summary": ["fit_summary", "selected_features"]
    },
    "replay_equivalence": {
      "selected_features": "exact_canonical_value",
      "fit_summary": "exact_canonical_value"
    },
    "retained_parameters": [
      {"name": "n_features", "parameter": "n_features", "required": false,
        "source": "parameter_value"},
      {"name": "depth_adjustment", "parameter": "depth_adjustment",
        "required": false, "source": "parameter_value"},
      {"name": "min_detection_pct", "parameter": "min_detection_pct",
        "required": false, "source": "parameter_value"},
      {"name": "max_detection_pct", "parameter": "max_detection_pct",
        "required": false, "source": "parameter_value"},
      {"name": "chunk_size", "parameter": "chunk_size", "required": false,
        "source": "parameter_value"}
    ]
  }]
}
